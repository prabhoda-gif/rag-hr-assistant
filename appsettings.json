{
  "OpenAI": {
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "RAGDemo": "Data Source=localhost;Initial Catalog=RAGDemo;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
  },
  "Rag": {
    "ChunkingStrategy": "fixed",
    "ChunkSize": 80,
    "ChunkOverlap": 15,
    "BatchSize": 20,
    "TopK": 5,
    "RelevanceThreshold": 0.5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
