# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.
#
# LEARNING NOTE — Why .env and not appsettings.json?
# appsettings.json is committed to git and visible to everyone.
# .env stays on your machine only. In production you'd use a proper
# secret manager (Azure Key Vault, AWS Secrets Manager) instead of .env.

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# SQL Server connection string.
# host.docker.internal is Docker's special hostname that means "my host machine".
# This lets the container reach SQL Server running on your laptop.
SQL_CONNECTION=Data Source=host.docker.internal;Initial Catalog=RAGDemo;Integrated Security=False;User Id=sa;Password=your-sa-password;Encrypt=False;TrustServerCertificate=True;
